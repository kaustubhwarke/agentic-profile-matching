# ===========================================================================
# Agentic Profile Matching — environment configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# All variables are prefixed with APM_ except the Anthropic key.
# ===========================================================================

# --- Anthropic / Claude (REQUIRED) -----------------------------------------
# Obtain a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- LLM configuration ------------------------------------------------------
# Latest, most capable model. Override per environment as needed.
# Alternatives: claude-sonnet-4-6 (faster/cheaper), claude-haiku-4-5 (cheapest).
APM_LLM_MODEL=claude-opus-4-8
APM_LLM_MAX_TOKENS=8000
# Reasoning effort: low | medium | high | max  (high recommended for ranking)
APM_LLM_EFFORT=high

# --- Embeddings / RAG -------------------------------------------------------
# Local sentence-transformers model (runs offline, no extra API cost).
APM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
APM_VECTOR_STORE_DIR=./chroma_db
APM_COLLECTION_NAME=resumes
# Number of candidates retrieved in the first-pass semantic search.
APM_RETRIEVAL_TOP_K=10

# --- Data locations ---------------------------------------------------------
APM_RESUME_DIR=./data/resumes
APM_JOB_DIR=./data/jobs
APM_REPORT_DIR=./reports

# --- Agent behaviour --------------------------------------------------------
# Max refinement loops before the agent forcibly ends the human-feedback loop.
APM_MAX_REFINEMENT_LOOPS=5
# Persisted LangGraph checkpoint database (SQLite).
APM_CHECKPOINT_DB=./checkpoints/graph_state.sqlite

# --- Multi-round screening (Part C) -----------------------------------------
# Round 1 retrieves up to this many resumes from the index ("from 100").
APM_SCREEN_POOL_SIZE=100
# Round 1 advances this many candidates to deep analysis ("top 10").
APM_SCREEN_SHORTLIST_SIZE=10
# Borderline score band [low, high): finalists here get improvement suggestions.
APM_BORDERLINE_LOW=50
APM_BORDERLINE_HIGH=70

# --- Observability ----------------------------------------------------------
APM_LOG_LEVEL=INFO
APM_LOG_JSON=false

# --- Optional: LangSmith tracing (leave blank to disable) -------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-xxxx
# LANGCHAIN_PROJECT=agentic-profile-matching
